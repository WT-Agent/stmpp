[
    {
        "id": "tools",
        "children": [
            {
                "caption": "Markdown Preview",
                "children": [
                    {
                        "caption": "Toggle Preview",
                        "command": "smp_toggle_preview"
                    },
                    {
                        "caption": "Open Preview to Side",
                        "command": "smp_open_preview",
                        "args": { "mode": "side" }
                    },
                    {
                        "caption": "Refresh",
                        "command": "smp_refresh_preview"
                    },
                    {
                        "caption": "Close Preview",
                        "command": "smp_close_preview"
                    },
                    { "caption": "-" },
                    {
                        "caption": "Export HTML...",
                        "command": "smp_export_html"
                    }
                ]
            }
        ]
    }
]
